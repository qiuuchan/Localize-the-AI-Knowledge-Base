# =====================================================================
# KB-AI · 环境变量模板
# 用途: 复制本文件为 .env 后填入真实值(API Key 等)
# 命令:  copy .env.example .env   然后用 notepad .env 编辑
# =====================================================================

# ===== 阿里云百炼 API Key =============================================
# 在阿里云百炼控制台申请: https://bailian.console.aliyun.com/
# 套餐: Token Plan 标准版 ¥198/月(用户已锁版决策)
ALIYUN_BAILIAN_API_KEY=sk-PLEASE-FILL-IN-YOUR-ALIYUN-BAILIAN-API-KEY

# ===== 模型名称 =======================================================
# v0.8.1: 80/20 双模型路由(简单问题 → Plus, 复杂问题 → Max)
# Plus 模型:默认 Qwen3.6-Plus(在 Token Plan ¥198 标准套餐内)
MODEL_NAME=qwen3.6-plus
# Max 模型:Qwen3.7-Max(复杂问题,2026-07-22 前 Credits 减半)
MODEL_NAME_MAX=qwen3.7-max
# 是否启用双模型路由(true/false)
MODEL_ROUTING_ENABLED=true
# 触发 Max 的关键词,逗号分隔
MODEL_ROUTING_COMPLEX_KEYWORDS=对比,分析为什么,如何改进,多步,请评估,方案,为什么

# ===== 图片入库模型(Vision) ===========================================
# 默认 qwen-vl-max(服务多企业老板,固定用 Max 保证图片理解质量)
# 可选 qwen-vl-plus(成本更低,适合海报/截图类简单文件)
CAPTION_MODEL=qwen-vl-max

# ===== Token Plan 使用量查询 URL (可选) ===============================
# 阿里云百炼提供用量查询接口,如果您希望系统展示月度用量,填入下面
# 留空表示不查询(默认)
TOKEN_PLAN_USAGE_URL=

# ===== Token Plan 套餐档位 ============================================
# standard = 标准版 ¥198/月 (默认)
# professional = 专业版 ¥598/月 (用量超 2 亿 token 后升级)
TOKEN_PLAN_TIER=standard

# ===== Dify Web 端口 ==================================================
# 默认 8080,如端口冲突可改为 8081 / 8082 等
DIFY_PORT=8080

# ===== M2b: Websearch 降级 (可选) =====================================
# Tavily 免费版:每月 1000 次;申请:https://tavily.com/
# 留空 = 不启用 Tavily(降级到 Bing)
TAVILY_API_KEY=tvly-PLEASE-FILL-IN

# Bing Search API:Azure 门户创建;免费层 1000 次/月
# 留空 = 不启用 Bing(AI 暂时不可用兜底)
BING_SEARCH_API_KEY=PLEASE-FILL-IN

# ===== P2 生成层:检索与加权 (v0.8.2) ==================================
# Cross-Encoder 精排候选数;<=0 表示关闭 rerank
RERANK_TOP_N=20

# 时间加权半衰期(天):默认 365,新资料权重接近 1,旧资料按指数衰减
TEMPORAL_HALF_LIFE_DAYS=365

# 检索 fallback 阈值:rerank 后所有 score 低于该值触发二次宽召回
RETRIEVAL_FALLBACK_THRESHOLD=0.3

# ===== 自动备份目录 (v0.8.6, 可选) =====================================
# stop.bat 停止服务后自动把 data\ + vectors\ 打包成 zip(FMEA F03)
# 默认:%USERPROFILE%\KB-AI-Backup(电脑硬盘);不要指向 U 盘本身(同盘备份无意义)
# KBAI_BACKUP_DIR=D:\backups\kb-ai
