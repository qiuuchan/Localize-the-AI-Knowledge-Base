# KB-AI golden-agent 评测集 v1.0(2026-08-27,工单 T14)
# 格式: {"question": "...", "expect_tools": ["kb_search", ...], "expect_keywords": [...], "category": "..."}
# 判定(见 run_agent_eval.py):
#   - 工具选择: 实际 tools_used ⊇ expect_tools(子集关系,允许模型多调)
#   - 任务完成: answer 非空 且 expect_keywords 全部命中(answer 子串)
#   - expect_keywords 为空 = 只要求 answer 非空(如 web_search / time 类)
# 5 类: kb_only / calc_only / time_only / multi_step_calc / web_fallback
# 私有仓保持「示例海鲜酒楼」原名;公开版由 sanitizer 统一替换为「示例海鲜酒楼」。

# ══════════════════════════════════════════════════════════
# category: kb_only (8 条) — 纯知识库检索,单次工具调用即可回答
# ══════════════════════════════════════════════════════════
{"question": "示例海鲜酒楼的会员卡等级有哪些？", "expect_tools": ["kb_search"], "expect_keywords": ["会员卡"], "category": "kb_only"}
{"question": "示例海鲜酒楼各部门配合时间表里门店调研安排在哪一天？", "expect_tools": ["kb_search"], "expect_keywords": ["调研"], "category": "kb_only"}
{"question": "仪表盘里的客户健康值是怎么计算的？", "expect_tools": ["kb_search"], "expect_keywords": ["健康值"], "category": "kb_only"}
{"question": "吾享H5链接和小程序路径有哪些？", "expect_tools": ["kb_search"], "expect_keywords": ["H5"], "category": "kb_only"}
{"question": "易订运营项目进度表里各阶段的时间节点是什么？", "expect_tools": ["kb_search"], "expect_keywords": ["阶段"], "category": "kb_only"}
{"question": "企业微信和个人微信相比有什么优势？", "expect_tools": ["kb_search"], "expect_keywords": ["企业微信"], "category": "kb_only"}
{"question": "商超AI短视频矩阵获客方案的三阶段实施节奏是什么？", "expect_tools": ["kb_search"], "expect_keywords": ["短视频"], "category": "kb_only"}
